{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of user receiving notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "chapter_update",
        "forum_reply",
        "admin_message",
        "story_update",
        "post_reaction"
      ],
      "description": "Type of notification"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message content"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether notification has been read"
    },
    "related_id": {
      "type": "string",
      "description": "ID of related entity (book, thread, etc.)"
    },
    "action_url": {
      "type": "string",
      "description": "URL to navigate to when clicked"
    }
  },
  "required": [
    "user_id",
    "type",
    "title",
    "message"
  ]
}