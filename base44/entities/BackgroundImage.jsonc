{
  "name": "BackgroundImage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name for the background"
    },
    "image_url": {
      "type": "string",
      "description": "URL to the background image"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL to thumbnail preview"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether background is available for users"
    }
  },
  "required": [
    "name",
    "image_url"
  ]
}